Ref: ai_requests.entity_id > entities.id
Ref: ai_requests.invoice_id > invoices.id
Ref: ai_requests.batch_id > payment_batches.id
Ref: ai_requests.request_id > payment_requests.id
Ref: ai_requests.check_run_id > invoice_check_runs.id
