Enum acceptance_decision {
  CONFIRMED [note: 'Counts as the independent acceptance source until an ERP acceptance exists (BR-17, BR-19, D-90)']
  REJECTED [note: 'Opens the exception Service acceptance rejected (AC-29.3)']
}

Enum invoice_source {
  UPLOAD
  EMAIL [note: 'Read from an XML attachment of the entity mailbox (UC-31, D-92)']
}

Enum fetch_trigger {
  SCHEDULED [note: 'Every 15 minutes (DF-63)']
  FETCH_NOW [note: 'The AP Accountant pressed Fetch now (AC-31.8)']
}

Enum message_outcome {
  PENDING [note: 'Stored by the fetch, attachments not all processed yet']
  PROCESSED
  NO_ATTACHMENT [note: 'Logged as No attachment; no invoice (AC-31.3)']
}

Enum attachment_outcome {
  INVOICE_CREATED [note: 'An XML attachment became an invoice; the checks of US-10 may still reject it (AC-31.1, AC-31.6)']
  REJECTED_NOT_XML [note: 'Only XML e-invoices are accepted in the MVP (BR-17, AC-31.2)']
  REJECTED_TOO_LARGE [note: 'Over 10 MB (DF-63)']
}

Enum authority_status {
  VALID
  ADJUSTED [note: 'A warning only; the adjustment invoice is handled by BR-31 (AC-10.14)']
  REPLACED [note: 'Stops the invoice at intake (V6, BR-39)']
  CANCELLED [note: 'Stops the invoice at intake (V6) or starts a cancellation (BR-31, BR-39)']
}

Enum lookup_trigger {
  INTAKE [note: 'After the signature check (BR-39)']
  RE_RUN [note: 'The AP Accountant ran the lookup again (AC-10.15)']
  SYNC_REFRESH [note: 'The ERP sync refreshed an invoice that is not yet sent (DF-64, AC-07.11)']
}

Enum lookup_outcome {
  ANSWERED
  UNAVAILABLE [note: 'No answer within 10 seconds; the invoice becomes an exception and intake never blocks (DF-64)']
}

Enum cancel_source {
  SELLER [note: 'Recorded by the AP Accountant with a reference, a date, and a file (AC-18.13)']
  AUTHORITY [note: 'Read from the simulated authority status (BR-39)']
}

Enum cancellation_effect {
  REJECTED [note: 'Waiting for Goods or Exception: rejected at once (V13, V21, AC-18.16)']
  WITHDRAWN_AND_REJECTED [note: 'In Batch in a request that is not signed: withdrawn and rejected in one action (AC-18.13)']
  REQUEST_CANCELLED [note: 'Signed and not sent: the request is cancelled (R9, V20, AC-18.14)']
  WARNING_ONLY [note: 'Sent or Paid: stored as a warning, no state changes (AC-18.15, D-67)']
  NO_EFFECT [note: 'The invoice is already in a final state or has not been checked yet; the notice is stored']
}

Enum notification_kind {
  BATCH_RELEASED [note: 'To the signers: payment requests wait for your signature (AC-32.1)']
  SIGNATURE_WAITING [note: 'To the Payment Approver at the required level after the Chief Accountant signed (AC-32.1)']
  EXCEPTION_OPENED [note: 'To the AP Accountant: a new exception (AC-32.2, AC-29.3)']
  REQUEST_RETURNED [note: 'To the AP Accountant: a request declined or cancelled because every line was removed (AC-32.3)']
  REQUEST_CANCELLED [note: 'To the AP Accountant and the Chief Accountant: a request cancelled by a cancellation notice (AC-18.14)']
  REPLY_REMINDER [note: 'A correction request past 5 working days without a reply; repeats daily (DF-21, AC-32.4)']
  SIGNATURE_REMINDER [note: 'A request past its due date still waits for the signer; repeats daily (DF-67, AC-32.5)']
}

Enum notification_object {
  INVOICE [note: 'Opens SCR-12 (DF-70)']
  BATCH [note: 'Opens SCR-50 for a batch released for signing (DF-70)']
  PAYMENT_REQUEST [note: 'Opens SCR-51, or SCR-30 for the AP Accountant (DF-70)']
}

