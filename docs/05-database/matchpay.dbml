Ref: anomaly_findings.entity_id > entities.id
Ref: anomaly_findings.invoice_id > invoices.id
Ref: anomaly_findings.check_run_id > invoice_check_runs.id
Ref: anomaly_findings.invoice_line_id > invoice_lines.id
Ref: anomaly_findings.related_invoice_id > invoices.id

Ref: anomaly_finding_invoices.entity_id > entities.id
Ref: anomaly_finding_invoices.finding_id > anomaly_findings.id
