Ref: price_history.entity_id > entities.id
Ref: price_history.item_id > erp_items.id
Ref: price_history.supplier_id > erp_suppliers.id
Ref: price_history.source_line_id > invoice_lines.id

Ref: supplier_entity_stats.entity_id > entities.id
