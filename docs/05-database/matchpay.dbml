Project matchpay {
  database_type: 'PostgreSQL'
  Note: '''
    MatchPay: a shared platform for a group of legal entities. The AI reads and matches incoming
    XML e-invoices, the Rule Engine admits clean ones to a payment batch, and authorised people
    sign consolidated payment requests. Step 5 of 9, logical schema, approved.
    PostgreSQL is assumed here and confirmed in Step 7 (D-47).

    Every business table carries entity_id (BR-09, G-06). Group-level tables (corporate_groups,
    group_sectors, entities) and the audit log (entity_id is NULL for group events) are the only
    exceptions, listed in the data model. The server derives the entity from the session and never
    from a request. SQL adds what DBML cannot express: partial unique indexes (shown as indexes
    with a note), composite foreign keys (entity_id, parent_id) so a child can never point to a
    parent of another entity (D-48), and the append-only rules of audit_log (D-55).

    Nothing is deleted: users are deactivated, tiers and profiles made inactive, invoices end in a
    final state. Derived values (dashboard rates, badges, accuracy, due soon) are computed when
    read and not stored, except the columns listed in the data model under "Stored although derivable".

    Not modelled here: login sessions and tokens, file storage beyond the XML original, the master
    data of the ERP simulator (seed files), server configuration (sync interval, retry counts,
    thresholds such as 0.90 and 98%), foreign invoices, PDF intake, foreign tax duties, payment
    method, and the cash flag (all removed by D-33, Advanced W-19..W-21), and SQL migrations (Step 9).
  '''
}

// ───────── Enums ─────────

Enum user_role {
  AP_ACCOUNTANT
  CHIEF_ACCOUNTANT
  PAYMENT_APPROVER
  REQUESTING_DEPARTMENT [note: 'Confirms or rejects a service acceptance of the own entity; one page, the acceptance queue (D-90, D-101, AC-02.9)']
  ENTITY_ADMIN
  GROUP_ADMIN [note: 'Belongs to the group, not to one entity (DF-14)']
  DEMO_OPERATOR [note: 'Demo only (D-12); belongs to the group and picks the entity in SCR-80']
}

Enum user_status {
  ACTIVE
  DEACTIVATED [note: 'No login; earlier decisions and signatures stay (AC-02.5)']
}

Enum grouping_mode {
  BY_SUPPLIER [note: 'One payment request per supplier (default)']
  PER_INVOICE [note: 'One payment request per invoice (AC-04.4)']
}

Enum gate_state {
  CLOSED [note: 'A new pair starts closed (D-29)']
  OPEN
}

Enum sync_status {
  RUNNING
  SUCCESS
  FAILED [note: 'ERP or mailbox unavailable; earlier data stays (AC-07.7, AC-31.7)']
}

Enum sync_record_type {
  PURCHASE_ORDER
  RECEIPT
  ACCEPTANCE
  SUPPLIER
  ITEM
  UNIT_CONVERSION
  ERP_USER
  TAX_RISK_ENTRY
  AUTHORITY_STATUS [note: 'An entry of the simulated authority status feed without a key, status, or date is rejected and logged (AC-07.12, D-93)']
}

Enum order_kind {
  GOODS
  SERVICE
}

Enum receipt_kind {
  GOODS_RECEIPT
  SERVICE_ACCEPTANCE
}

Enum persona_kind {
  BUYER
  WAREHOUSE_KEEPER
  ACCEPTOR
}

Enum invoice_state {
  RECEIVED
  IN_CHECK
  WAITING_FOR_GOODS
  SEPARATED [note: 'Final (BR-33)']
  REJECTED [note: 'Final (BR-33)']
  EXCEPTION
  IN_BATCH
  SIGNED
  SENT
  PAID [note: 'Final (BR-33)']
  SUPERSEDED [note: 'Final (BR-33)']
}

Enum invoice_flow {
  GOODS_WITH_ORDER
  SERVICES_WITH_ORDER
  RECURRING
  SUBSCRIPTION [note: 'Advanced flow (W-04): always an exception, no automatic handling (AC-12.7)']
  UNSUPPORTED_FOREIGN [note: 'Unsupported: foreign invoice (D-33); only Reject resolves it (AC-12.9)']
  EMPLOYEE_EXPENSE
  OTHER
}

Enum invoice_kind {
  ORIGINAL
  ADJUSTMENT
  REPLACEMENT
}

Enum trust_level {
  HIGH [note: 'Seller signature and tax-authority code']
  SIGNED_NON_CODED [note: 'Seller signature, no tax-authority code, sector in the configured list (D-24)']
}

Enum signature_status {
  NOT_CHECKED
  VALID
  INVALID
}

Enum rejection_reason {
  SIGNATURE_FAILED
  XML_NOT_SUPPORTED [note: 'Malformed XML or a schema version not in the supported list (AC-10.3)']
  BUYER_TAX_CODE_MISMATCH
  EXACT_DUPLICATE
  REJECTED_BY_PERSON [note: 'Rejected with a reason from an exception (AC-18.6, AC-21.4)']
  CANCELLED_AT_AUTHORITY [note: 'Status Cancelled at the tax authority, at intake (V6) or found by a later refresh (V13, V21); the status date is on the lookup (BR-39, AC-10.12)']
  REPLACED_AT_AUTHORITY [note: 'Status Replaced at the tax authority; the replacing invoice is named on the lookup (BR-39, AC-10.13)']
  CANCELLED_BY_SELLER [note: 'A cancellation notice from the seller was recorded (V13, V21, BR-31, AC-18.13, AC-18.16)']
}

Enum run_trigger {
  UPLOAD
  RE_RUN [note: 'AP Accountant re-runs after an AI failure (DF-08), or runs the authority status lookup again (AC-10.15)']
  RESOLUTION [note: 'A person resolved a reason (AC-18.3)']
  ERP_SYNC [note: 'A receipt or corrected data arrived (BR-14)']
  FOLLOW_UP [note: 'A follow-up invoice is checked (UC-20)']
  RISK_LIST_CHANGE [note: 'BR-08']
  ACCEPTANCE [note: 'The Requesting Department confirmed or rejected a service acceptance (UC-29, AC-29.2)']
}

Enum run_outcome {
  RUNNING
  COMPLETED
  AI_FAILED [note: 'Unavailable, timeout, or wrong schema; the invoice becomes an exception (DF-08)']
}

Enum match_method {
  MAPPING_TABLE
  EMBEDDING_FUSION [note: 'Embedding with the signal-fusion model, no LLM call']
  LLM [note: 'Called once for the line, then fusion is recomputed (DF-15)']
  PERSON [note: 'A person confirmed or chose the item (AC-18.2)']
}

Enum identification_method {
  DETERMINISTIC [note: 'Tax code and order number on the invoice, no LLM (AC-13.8)']
  LLM
}

Enum anomaly_kind {
  UNUSUAL_PRICE
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
  SPLIT_ORDERS
  RECURRING_JUMP
  PERIOD_ALREADY_INVOICED
  NEW_SUPPLIER
