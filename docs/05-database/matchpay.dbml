Ref: exception_follow_up_links.entity_id > entities.id
Ref: exception_follow_up_links.exception_id > exceptions.id
Ref: exception_follow_up_links.follow_up_invoice_id > invoices.id
Ref: exception_follow_up_links.linked_by > users.id
