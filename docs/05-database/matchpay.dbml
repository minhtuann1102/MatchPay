  erp_sync_runs
  erp_sync_rejections
  erp_users
  erp_suppliers
  erp_supplier_bank_accounts
  erp_items
  erp_unit_conversions
  erp_purchase_orders
  erp_po_lines
  erp_receipts
  erp_receipt_lines
  tax_risk_entries
}

TableGroup erp_simulator {
  sim_personas
  sim_purchase_orders
  sim_po_lines
  sim_receipts
  sim_receipt_lines
}

TableGroup accumulated_data {
  item_mappings
  recurring_profiles
  recurring_profile_periods
  price_history
  supplier_entity_stats
}

TableGroup invoices_group {
  invoices
  invoice_documents
  invoice_lines
  invoice_corrections
  invoice_receipts
}

TableGroup ai_and_rules {
  invoice_check_runs
  ai_flow_classifications
  ai_identifications
  invoice_line_matches
  anomaly_findings
  anomaly_finding_invoices
  rule_evaluations
  rule_condition_results
