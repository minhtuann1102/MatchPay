Ref: invoices.rejected_by > users.id
Ref: invoices.uploaded_by > users.id

Ref: invoice_documents.entity_id > entities.id
Ref: invoice_documents.invoice_id - invoices.id
Ref: invoice_documents.stored_by > users.id

Ref: invoice_lines.entity_id > entities.id
Ref: invoice_lines.invoice_id > invoices.id

Ref: invoice_corrections.entity_id > entities.id
Ref: invoice_corrections.correcting_invoice_id > invoices.id
Ref: invoice_corrections.original_invoice_id > invoices.id

Ref: invoice_receipts.entity_id > entities.id
