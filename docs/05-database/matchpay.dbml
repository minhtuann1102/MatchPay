Project matchpay {
  database_type: 'PostgreSQL'
  Note: '''
    MatchPay: a shared platform for a group of legal entities. The AI reads and matches incoming
    XML e-invoices, the Rule Engine admits clean ones to a payment batch, and authorised people
    sign consolidated payment requests. Step 5 of 9, logical schema, draft for review.
    PostgreSQL is assumed here and confirmed in Step 7 (D-47).

    Every business table carries entity_id (BR-09, G-06). Group-level tables (corporate_groups,
    group_sectors, entities) and the audit log (entity_id is NULL for group events) are the only
    exceptions, listed in the data model. The server derives the entity from the session and never
    from a request. SQL adds what DBML cannot express: partial unique indexes (shown as indexes
    with a note), composite foreign keys (entity_id, parent_id) so a child can never point to a
    parent of another entity (D-48), and the append-only rules of audit_log (D-55).

    Nothing is deleted: users are deactivated, tiers and profiles made inactive, invoices end in a
    final state. Derived values (dashboard rates, badges, accuracy, due soon) are computed when
    read and not stored, except the columns listed in the data model under "Stored although derivable".

    Not modelled here: login sessions and tokens, file storage beyond the XML original, the master
    data of the ERP simulator (seed files), server configuration (sync interval, retry counts,
    thresholds such as 0.90 and 98%), foreign invoices, PDF intake, foreign tax duties, payment
    method, and the cash flag (all removed by D-33, Advanced W-19..W-21), and SQL migrations (Step 9).
  '''
}

// ───────── Enums ─────────

Enum user_role {
  AP_ACCOUNTANT
  CHIEF_ACCOUNTANT
  PAYMENT_APPROVER
  ENTITY_ADMIN
  GROUP_ADMIN [note: 'Belongs to the group, not to one entity (DF-14)']
  DEMO_OPERATOR [note: 'Demo only (D-12); belongs to the group and picks the entity in SCR-80']
}

Enum user_status {
  ACTIVE
  DEACTIVATED [note: 'No login; earlier decisions and signatures stay (AC-02.5)']
}

Enum grouping_mode {
  BY_SUPPLIER [note: 'One payment request per supplier (default)']
  PER_INVOICE [note: 'One payment request per invoice (AC-04.4)']
}

Enum gate_state {
  CLOSED [note: 'A new pair starts closed (D-29)']
  OPEN
}

Enum sync_status {
  RUNNING
  SUCCESS
  FAILED [note: 'ERP unavailable; earlier data stays (AC-07.7)']
}

Enum sync_record_type {
  PURCHASE_ORDER
  RECEIPT
  ACCEPTANCE
  SUPPLIER
  ITEM
  UNIT_CONVERSION
  ERP_USER
  TAX_RISK_ENTRY
}

Enum order_kind {
  GOODS
  SERVICE
}

Enum receipt_kind {
  GOODS_RECEIPT
  SERVICE_ACCEPTANCE
}

Enum persona_kind {
  BUYER
  WAREHOUSE_KEEPER
  ACCEPTOR
}

Enum invoice_state {
  RECEIVED
  IN_CHECK
  WAITING_FOR_GOODS
  SEPARATED [note: 'Final (BR-33)']
  REJECTED [note: 'Final (BR-33)']
  EXCEPTION
  IN_BATCH
  SIGNED
  SENT
  PAID [note: 'Final (BR-33)']
  SUPERSEDED [note: 'Final (BR-33)']
}

Enum invoice_flow {
  GOODS_WITH_ORDER
  SERVICES_WITH_ORDER
  RECURRING
  SUBSCRIPTION [note: 'Advanced flow (W-04): always an exception, no automatic handling (AC-12.7)']
  UNSUPPORTED_FOREIGN [note: 'Unsupported: foreign invoice (D-33); only Reject resolves it (AC-12.9)']
  EMPLOYEE_EXPENSE
  OTHER
}

Enum invoice_kind {
  ORIGINAL
  ADJUSTMENT
  REPLACEMENT
}

Enum trust_level {
  HIGH [note: 'Seller signature and tax-authority code']
  SIGNED_NON_CODED [note: 'Seller signature, no tax-authority code, sector in the configured list (D-24)']
}

Enum signature_status {
  NOT_CHECKED
  VALID
  INVALID
}

Enum rejection_reason {
  SIGNATURE_FAILED
  XML_NOT_SUPPORTED [note: 'Malformed XML or a schema version not in the supported list (AC-10.3)']
  BUYER_TAX_CODE_MISMATCH
  EXACT_DUPLICATE
  REJECTED_BY_PERSON [note: 'Rejected with a reason from an exception (AC-18.6, AC-21.4)']
}

Enum run_trigger {
  UPLOAD
  RE_RUN [note: 'AP Accountant re-runs after an AI failure (DF-08)']
  RESOLUTION [note: 'A person resolved a reason (AC-18.3)']
  ERP_SYNC [note: 'A receipt or corrected data arrived (BR-14)']
  FOLLOW_UP [note: 'A follow-up invoice is checked (UC-20)']
  RISK_LIST_CHANGE [note: 'BR-08']
}

Enum run_outcome {
  RUNNING
  COMPLETED
  AI_FAILED [note: 'Unavailable, timeout, or wrong schema; the invoice becomes an exception (DF-08)']
}

Enum match_method {
  MAPPING_TABLE
  EMBEDDING_FUSION [note: 'Embedding with the signal-fusion model, no LLM call']
  LLM [note: 'Called once for the line, then fusion is recomputed (DF-15)']
  PERSON [note: 'A person confirmed or chose the item (AC-18.2)']
}

Enum identification_method {
  DETERMINISTIC [note: 'Tax code and order number on the invoice, no LLM (AC-13.8)']
  LLM
}

Enum anomaly_kind {
  UNUSUAL_PRICE
  EXACT_DUPLICATE
  POSSIBLE_DUPLICATE
  SPLIT_ORDERS
  RECURRING_JUMP
  PERIOD_ALREADY_INVOICED
  NEW_SUPPLIER
  BANK_ACCOUNT_CHANGED
}

Enum anomaly_result {
  FLAGGED
  NOT_FLAGGED [note: 'The numbers are kept, for example +18.3% against a 20% limit (AC-15.1)']
  SKIPPED [note: 'Too little history; the skip is recorded (DF-20)']
  UNAVAILABLE [note: 'The check could not run; the invoice becomes an exception (AC-15.11)']
}

Enum condition_result {
  PASS
  FAIL
  NOT_EVALUATED [note: 'An AI step failed and its evidence is missing (AC-16.11)']
}

Enum rule_decision {
  ADMITTED [note: 'V11, V12: In Batch']
  EXCEPTION [note: 'V10']
  WAITING_FOR_GOODS [note: 'V8']
  SEPARATED [note: 'V7']
  REJECTED [note: 'V6']
}

Enum exception_state {
  OPEN
  IN_REVIEW
  WAITING_FOR_SUPPLIER
  WAITING_FOR_DATA_FIX
  WAITING_FOR_DECISION
  CLOSED [note: 'Final; carries an outcome (BR-34)']
}

Enum exception_outcome {
  ADMITTED
  APPROVED_INDIVIDUALLY
  REJECTED
  SUPERSEDED
  AUTO_CLOSED
}

Enum decision_role {
  CHIEF_ACCOUNTANT [note: 'Tax-risk hold']
  PAYMENT_APPROVER [note: 'Individual approval']
}

Enum reason_code {
  GATE_CLOSED
  TAX_RISK_HOLD
  AI_UNAVAILABLE
  FLOW_UNCLEAR
  ENTITY_UNCONFIRMED
  NO_MATCHING_PROFILE
  LINE_NOT_MATCHED
  PRICE_OUT_OF_TOLERANCE
  QUANTITY_ABOVE_RECEIVED
  TOTAL_ABOVE_THRESHOLD
  NO_INDEPENDENT_SOURCE
  NO_TAX_AUTHORITY_CODE
  UNUSUAL_PRICE
  POSSIBLE_DUPLICATE
  SPLIT_ORDERS
  RECURRING_OUT_OF_THRESHOLD
  PERIOD_ALREADY_INVOICED
  NEW_SUPPLIER
  BANK_ACCOUNT_CHANGED
  ANOMALY_CHECK_UNAVAILABLE
  UNSUPPORTED_FOREIGN_INVOICE
  ADVANCED_FLOW
  ADJUSTMENT_OR_REPLACEMENT [note: 'Always a person (BR-31)']
  WITHDRAWN_FROM_BATCH
  APPROVAL_DECLINED
  PAYMENT_FAILED
}

Enum followup_kind {
  FRESH_STANDARD [note: 'Closes the exception by itself when it passes (BR-26)']
  ADJUSTMENT
  REPLACEMENT
}

Enum followup_status {
  LINKED
  CONFIRMED [note: 'The AP Accountant confirmed an adjustment or replacement (BR-31)']
  CLOSED_AUTOMATICALLY
}

Enum message_kind {
  CORRECTION_REQUEST
  DATA_FIX_NOTICE
  REISSUE_REQUEST
}

Enum recipient_type {
  SUPPLIER
  INTERNAL_TEAM
}

Enum send_status {
  DRAFT
  SENT
  NOT_SENT [note: 'Email Service failed; retry allowed (AC-19.6)']
}

Enum hold_decision {
  RELEASE
  REJECT
}

Enum approval_decision {
  APPROVED
  DECLINED
}

Enum batch_state {
  OPEN
  IN_REVIEW
  IN_SIGNING
  SIGNED
  SENT
  COMPLETED [note: 'Final (BR-35)']
}

Enum request_state {
  AWAITING_CHIEF_ACCOUNTANT
  AWAITING_PAYMENT_APPROVER
  SIGNED
  SENT
  PAID [note: 'Final (BR-35)']
  CANCELLED [note: 'Final (BR-35)']
}

Enum admitted_via {
  RULE_ENGINE
  INDIVIDUAL_APPROVAL
}

Enum withdraw_reason {
  SAMPLE_ERROR
  WITHDRAWN_BY_AP
  REMOVED_BY_SIGNER
  REQUEST_DECLINED
  RISK_LIST_CHANGE
}

Enum sample_method {
  AI
