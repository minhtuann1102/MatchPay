}

Enum sample_reason {
  HIGH_VALUE
  GATE_RECENTLY_OPENED
  OFTEN_MATCHED_WRONG
  HIGHEST_VALUE_FALLBACK
}

Enum sample_mark {
  PENDING
  OK
  ERROR
}

Enum signer_role {
  CHIEF_ACCOUNTANT
  PAYMENT_APPROVER
}

Enum signature_state {
  VALID
  VOIDED [note: 'A line was removed or the content changed after the signature (BR-37, R5)']
}

Enum cancel_kind {
