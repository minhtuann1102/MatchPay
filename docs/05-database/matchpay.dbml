}

Enum anomaly_result {
  FLAGGED
  NOT_FLAGGED [note: 'The numbers are kept, for example +18.3% against a 20% limit (AC-15.1)']
  SKIPPED [note: 'Too little history; the skip is recorded (DF-20)']
  UNAVAILABLE [note: 'The check could not run; the invoice becomes an exception (AC-15.11)']
}

Enum condition_result {
  PASS
  FAIL
  NOT_EVALUATED [note: 'An AI step failed and its evidence is missing (AC-16.11)']
}

Enum rule_decision {
  ADMITTED [note: 'V11, V12: In Batch']
  EXCEPTION [note: 'V10']
  WAITING_FOR_GOODS [note: 'V8']
  SEPARATED [note: 'V7']
  REJECTED [note: 'V6']
}

Enum exception_state {
  OPEN
  IN_REVIEW
  WAITING_FOR_SUPPLIER
  WAITING_FOR_DATA_FIX
  WAITING_FOR_DECISION
  CLOSED [note: 'Final; carries an outcome (BR-34)']
}

Enum exception_outcome {
  ADMITTED
  APPROVED_INDIVIDUALLY
  REJECTED
  SUPERSEDED
  AUTO_CLOSED
}

Enum decision_role {
  CHIEF_ACCOUNTANT [note: 'Tax-risk hold']
  PAYMENT_APPROVER [note: 'Individual approval']
}

Enum reason_code {
  GATE_CLOSED
  TAX_RISK_HOLD
  AI_UNAVAILABLE
  FLOW_UNCLEAR
  ENTITY_UNCONFIRMED
  WRONG_BUYER_TAX_CODE [note: 'Added by a Wrong entity report when the XML buyer tax code is missing or differs from the entity (D-68); intake rejection BR-01 is unchanged']
  WRONG_ENTITY_REPORTED [note: 'Added by a Wrong entity report when the XML is not at fault (D-68)']
  NO_MATCHING_PROFILE
  LINE_NOT_MATCHED
  PRICE_OUT_OF_TOLERANCE
  QUANTITY_ABOVE_RECEIVED
  TOTAL_ABOVE_THRESHOLD
  NO_INDEPENDENT_SOURCE
  NO_TAX_AUTHORITY_CODE
  UNUSUAL_PRICE
  POSSIBLE_DUPLICATE
  SPLIT_ORDERS
  RECURRING_OUT_OF_THRESHOLD
  PERIOD_ALREADY_INVOICED
  NEW_SUPPLIER
  BANK_ACCOUNT_CHANGED
  ANOMALY_CHECK_UNAVAILABLE
  UNSUPPORTED_FOREIGN_INVOICE
  ADVANCED_FLOW
  ADJUSTMENT_OR_REPLACEMENT [note: 'Always a person (BR-31)']
  WITHDRAWN_FROM_BATCH
  APPROVAL_DECLINED
  PAYMENT_FAILED
  SERVICE_ACCEPTANCE_REJECTED [note: 'The Requesting Department rejected the acceptance; cannot be approved individually (D-31, D-90, AC-29.3)']
  AUTHORITY_STATUS_UNAVAILABLE [note: 'The status lookup did not answer within 10 seconds; never admitted with an unknown status (BR-39, DF-64, AC-10.15)']
  CANCELLED_AFTER_SIGNING [note: 'The invoice was cancelled while its request was Signed and not yet sent (V20, R9, AC-18.14)']
  REQUEST_CANCELLED_OTHER_INVOICE [note: 'Its request was cancelled because another invoice in it was cancelled (V20, R9, AC-18.14)']
}

Enum wrong_entity_source {
  BUYER_TAX_CODE [note: 'The buyer tax code on the XML is missing or differs from the tax code of the entity']
  BUYER_NAME [note: 'The tax code matches but the buyer name on the XML names another company (a warning only, D-26)']
  ORDER_REFERENCE [note: 'The order reference is not found in this entity (AC-13.6)']
  ERP_DATA [note: 'The ERP data of this entity (order, receipt, supplier) does not fit the invoice']
  NOT_TRACED [note: 'No source was found; the person\'s note is the only evidence']
}

Enum followup_kind {
  FRESH_STANDARD [note: 'Closes the exception by itself when it passes (BR-26)']
  ADJUSTMENT
  REPLACEMENT
}

Enum followup_status {
  LINKED
  CONFIRMED [note: 'The AP Accountant confirmed an adjustment or replacement (BR-31)']
  CLOSED_AUTOMATICALLY
