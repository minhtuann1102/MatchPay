Ref: invoice_receipts.receipt_id > erp_receipts.id
Ref: invoice_receipts.check_run_id > invoice_check_runs.id

Ref: invoice_check_runs.entity_id > entities.id
Ref: invoice_check_runs.invoice_id > invoices.id
